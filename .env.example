# OpenAI 兼容教学模型（必填）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
AUTH_TOKEN_TTL_HOURS=720
GRAPH_LLM_TIMEOUT_SECONDS=180
GRAPH_BATCH_ITEMS=25
GRAPH_EXTRACT_MAX_TOKENS=8192

# Neo4j（可选；未配置时读取 kb/graph 下的 JSON 图谱）
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 本地模型；默认值假设 models/ 与本项目位于同一个父目录
EMBED_MODEL_PATH=/absolute/path/to/Qwen3-Embedding-0.6B
RERANK_MODEL_PATH=/absolute/path/to/Qwen3-Reranker-0.6B
VLM_MODEL_PATH=/absolute/path/to/Qwen3-VL-4B-Instruct

# 本地知识库
MILVUS_DB_PATH=kb/vectordb/milvus.db
MILVUS_COLLECTION=linear_algebra_kb

# 完整消息永久存 SQLite；以下仅控制每轮注入模型的最近上下文窗口
SESSION_CONTEXT_MAX_MESSAGES=40
SESSION_CONTEXT_MAX_CHARS=30000

# 仅离线解析 PDF 时使用
MINERU_TOKEN=
