    ],
    "page_idx": 3
  },
  {
    "type": "header",
    "text": "数据结构知识点与习题精讲(微课版)——专业课学习与考研辅导",
    "bbox": [
      118,
      61,
      585,
      75
    ],
    "page_idx": 3
  },
  {
    "type": "image",
    "img_path": "images/1becea2e974bdbb6ab0d193384e32dc6d49ade495cf6435845fca31842572351.jpg",
    "image_caption": [],
